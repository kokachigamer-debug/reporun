{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RepoRun",
  "version": "0.1.0",
  "identifier": "dev.reporun.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "RepoRun",
        "width": 1180,
        "height": 760,
        "minWidth": 940,
        "minHeight": 620,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "externalBin": [],
    "copyright": "",
    "category": "DeveloperTool",
    "shortDescription": "Classify and run GitHub repos locally.",
    "longDescription": "RepoRun classifies and runs GitHub repositories locally with restricted execution and pre-flight risk scanning."
  },
  "plugins": {
    "updater": {
      "active": false,
      "endpoints": [
        "https://github.com/reporun/reporun/releases/latest/download/latest.json"
      ],
      "dialog": true,
      "pubkey": ""
    }
  }
}
