# RepoRun example environment file. Copy to `.env` and fill in to enable the
# server-side features. RepoRun runs locally; these only configure the
# internet-touching bits (sign-in, license checks, optional GitHub auth).

# Supabase (Section 9) — free tier. Required for auth + server-side trial tracking.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Payment gateway (Section 10) — merchant of record. Wire the checkout URL into
# the Signup flow; RepoRun never handles card data.
VITE_LEMON_SQUEEZY_STORE=
# or VITE_GUMROAD_PRODUCT_ID=

# Optional GitHub auth (Section 4) — raises rate limit from 10 to 30 req/min.
# Offered non-intrusively. Never required.
VITE_GITHUB_TOKEN=

# Tauri updater signing (Section 14) — updater artifacts MUST be signed even
# before installer code-signing (Section 13) is added. Generate with
# `npm run tauri signer generate -- -w ~/.tauri/reporun.key`.
# TAURI_SIGNING_PRIVATE_KEY=
# TAURI_SIGNING_PRIVATE_KEY_PASSWORD=
